C1D3 DA        ; EXAB
C1D4 29 0F     ; JRNZM F_LOOP
C1D6 02 FF     ; LIA FF
C1D8 37        ; RTN
C1D9 DA        ; EXAB               F_FOUND:
C1DA 9F        ; LP 1F
C1DB DB        ; EXAM
C1DC 96        ; LP 16
C1DD 59        ; LDM
C1DE 9F        ; LP 1F
C1DF 44        ; ADM
C1E0 59        ; LDM
C1E1 37        ; RTN
; ---- 玉を1歩進める。落としたらA=1 ----
