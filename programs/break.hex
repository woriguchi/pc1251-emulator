# title: ブロック崩し(マシン語)
# 横向きのブロック崩し。↑↓でパドル、SPACEかENTERで打ち出す。BRK(Esc)でやめる。
# 同じ名前のbreak.basがCALL &C000で呼ぶ。アセンブラで作ったもので、「;」のあとがニーモニック。
; ---------------------------------------------------------------------
; 画面は横120列×縦7ドット。左の90列が遊ぶ場所、右の30列に残りの玉と得点。
; 左端のパドルで玉を打ち返し、右のブロックの壁を削る。壁と右端のあいだは
; 空いているので、そこへ回り込ませると壁を裏から削れる。壁はゆっくり左へ
; 寄ってきて、先端が12列目まで来ると押し切られて玉を1個失う。
; 玉のyは1/32ドット単位で持つ(32〜224が0〜6段目)。1列進むごとにyが4〜8変わる。xは1歩に1列ずつ進め、
; 1フレームに2〜3歩。1歩ごとに横、縦の順に動かし、ブロックに当たった
; 向きで跳ね返す。ブロックは1列6本で、1本を7ビット(縦7段)の1バイトで持つ。
; 内部RAMの10h〜2Fhを変数に使う。入るときにBASICの値をSAVEへ退避し、
; 出るときに入れ替えて戻す。そのためゲームが終わるとSAVEに変数が残り、
; 得点(5桁、1桁1バイト)はC5F6〜C5FA番地からBASICのPEEKで読める。
; ---------------------------------------------------------------------
; ---- 入り口 ----
C000 90        ; LP 10              START: BASICの内部RAMを退避
C001 00 1F     ; LII 1F
C003 10 C5 E0  ; LIDP C5E0  (SAVE)
C006 19        ; EXWD
C007 02 03     ; LIA 03
C009 98        ; LP 18
C00A DB        ; EXAM
C00B 23        ; CLRA
C00C 99        ; LP 19
C00D DB        ; EXAM
C00E 02 02     ; LIA 02             normal: パドル2段、1フレームに2歩、壁は40フレームで1列
C010 95        ; LP 15
C011 DB        ; EXAM
C012 02 08     ; LIA 08
C014 9A        ; LP 1A
C015 DB        ; EXAM
C016 02 28     ; LIA 28
C018 AD        ; LP 2D
C019 DB        ; EXAM
C01A 10 C5 DF  ; LIDP C5DF  (LEVELSEL)
C01D 57        ; LDD
C01E 67 01     ; CPIA 01
C020 28 0D     ; JRNZP ST_NORM
C022 02 03     ; LIA 03             easy: パドル3段、1フレームに1.5歩、壁は60フレームで1列
C024 95        ; LP 15
C025 DB        ; EXAM
C026 02 06     ; LIA 06
C028 9A        ; LP 1A
C029 DB        ; EXAM
C02A 02 3C     ; LIA 3C
C02C AD        ; LP 2D
C02D DB        ; EXAM
C02E 23        ; CLRA               ST_NORM:
C02F 9B        ; LP 1B
C030 DB        ; EXAM
C031 23        ; CLRA
C032 9E        ; LP 1E
C033 DB        ; EXAM
C034 23        ; CLRA
C035 A6        ; LP 26              得点を0に
C036 00 04     ; LII 04
C038 1E        ; FILM
C039 02 02     ; LIA 02
C03B 94        ; LP 14
C03C DB        ; EXAM
C03D 02 01     ; LIA 01             液晶の表示をつけたままにする
C03F 12 5F     ; LIP 5F  (PORTC)
C041 DB        ; EXAM
C042 DF        ; OUTC
C043 A0        ; LP 20              NEWWALL: 6本ぜんぶ7段そろえる
C044 02 7F     ; LIA 7F
C046 00 05     ; LII 05
C048 1E        ; FILM
C049 02 2A     ; LIA 2A
C04B 9C        ; LP 1C
C04C DB        ; EXAM
C04D 02 32     ; LIA 32  (WALL0)    RSTWALL:
C04F 96        ; LP 16
C050 DB        ; EXAM
C051 23        ; CLRA
C052 97        ; LP 17
C053 DB        ; EXAM
; ---- パドルに玉を乗せて、打ち出すのを待つ ----
C054 78 C1 2C  ; CALL C12C  (KEYS)  SERVE:
C057 78 C1 A3  ; CALL C1A3  (SETBALL)
C05A 78 C3 17  ; CALL C317  (DRAW)
C05D 78 C4 17  ; CALL C417  (DELAY)
C060 6B 08     ; TEST 08            BRK
C062 7C C1 1A  ; JPNZ C11A  (QUIT)
C065 78 C1 90  ; CALL C190  (FIRE)
C068 39 15     ; JRZM SERVE
C06A 02 02     ; LIA 02
C06C 03 28     ; LIB 28
C06E 78 C4 2D  ; CALL C42D  (TONE)
; ---- 遊んでいるあいだの1フレーム ----
C071 78 C1 2C  ; CALL C12C  (KEYS)  PLAY:
C074 97        ; LP 17              壁を寄せる
C075 70 01     ; ADIM 01
C077 59        ; LDM
C078 AD        ; LP 2D              (ADVR)-(ADVT)が正ならまだ
C079 C7        ; CPMA
C07A 38 03     ; JRZP PL_ADV0
C07C 2A 07     ; JRNCP PL_ADV
C07E 97        ; LP 17              PL_ADV0:
C07F 23        ; CLRA
C080 DB        ; EXAM
C081 96        ; LP 16
C082 71 01     ; SBIM 01
C084 78 C1 C2  ; CALL C1C2  (FRONT) PL_ADV: 押し切られたか
C087 67 0C     ; CPIA 0C  (DANGER)
C089 7F C0 C7  ; JPC C0C7  (CRUSH)
C08C 9A        ; LP 1A              今回の歩数 = (端数+速さ)/4
C08D 59        ; LDM
C08E 9B        ; LP 1B
C08F 44        ; ADM
C090 59        ; LDM
C091 D1        ; RC
C092 D2        ; SR
C093 D1        ; RC
C094 D2        ; SR
C095 AB        ; LP 2B
C096 DB        ; EXAM
C097 9B        ; LP 1B
C098 60 03     ; ANIM 03
C09A AB        ; LP 2B              PL_STEP:
C09B 71 01     ; SBIM 01
C09D 3A 12     ; JRCP PL_DRAW
C09F 78 C1 E2  ; CALL C1E2  (STEP)
C0A2 67 01     ; CPIA 01
C0A4 7E C0 BE  ; JPZ C0BE  (LOST)
C0A7 9C        ; LP 1C
C0A8 59        ; LDM
C0A9 67 00     ; CPIA 00
C0AB 7E C0 E3  ; JPZ C0E3  (CLEAR)
C0AE 2D 15     ; JRM PL_STEP
C0B0 78 C3 17  ; CALL C317  (DRAW)  PL_DRAW:
C0B3 78 C4 17  ; CALL C417  (DELAY)
C0B6 6B 08     ; TEST 08
C0B8 7C C1 1A  ; JPNZ C11A  (QUIT)
C0BB 79 C0 71  ; JP C071  (PLAY)
; ---- 玉を落とした、押し切られた、面をクリアした ----
C0BE 02 1E     ; LIA 1E             LOST:
C0C0 03 32     ; LIB 32
C0C2 78 C4 2D  ; CALL C42D  (TONE)
C0C5 2C 0C     ; JRP MISS
C0C7 02 28     ; LIA 28             CRUSH:
C0C9 03 3C     ; LIB 3C
C0CB 78 C4 2D  ; CALL C42D  (TONE)
C0CE 02 32     ; LIA 32  (WALL0)    壁を元の位置に戻す
C0D0 96        ; LP 16
C0D1 DB        ; EXAM
C0D2 02 FF     ; LIA FF             MISS: 玉を消して少し止める
C0D4 90        ; LP 10
C0D5 DB        ; EXAM
C0D6 02 0E     ; LIA 0E
C0D8 78 C4 1F  ; CALL C41F  (PAUSE)
C0DB 98        ; LP 18
C0DC 71 01     ; SBIM 01
C0DE 38 3B     ; JRZP QUIT
C0E0 79 C0 54  ; JP C054  (SERVE)
C0E3 02 05     ; LIA 05             CLEAR: 500点
C0E5 A8        ; LP 28
C0E6 78 C2 A1  ; CALL C2A1  (ADDDIG)
C0E9 99        ; LP 19
C0EA 59        ; LDM
C0EB 67 08     ; CPIA 08
C0ED 2A 0B     ; JRNCP CL_LV
C0EF 70 01     ; ADIM 01
C0F1 9A        ; LP 1A              面ごとに速くする(最大で1フレーム3歩)
C0F2 59        ; LDM
C0F3 67 0C     ; CPIA 0C
C0F5 2A 03     ; JRNCP CL_LV
C0F7 70 01     ; ADIM 01
C0F9 02 FF     ; LIA FF             CL_LV:
C0FB 90        ; LP 10
C0FC DB        ; EXAM
C0FD 02 05     ; LIA 05
C0FF 03 28     ; LIB 28
C101 78 C4 2D  ; CALL C42D  (TONE)
C104 02 03     ; LIA 03
C106 03 3C     ; LIB 3C
C108 78 C4 2D  ; CALL C42D  (TONE)
C10B 02 02     ; LIA 02
C10D 03 5A     ; LIB 5A
C10F 78 C4 2D  ; CALL C42D  (TONE)
C112 02 0C     ; LIA 0C
C114 78 C4 1F  ; CALL C41F  (PAUSE)
C117 79 C0 43  ; JP C043  (NEWWALL)
C11A 90        ; LP 10              QUIT: 内部RAMをBASICの値に戻す(変数はSAVEに残る)
C11B 00 1F     ; LII 1F
C11D 10 C5 E0  ; LIDP C5E0  (SAVE)
C120 19        ; EXWD
C121 23        ; CLRA
C122 12 5C     ; LIP 5C  (KEYPA)
C124 DB        ; EXAM
C125 5D        ; OUTA
C126 23        ; CLRA
C127 12 5D     ; LIP 5D  (KEYPB)
C129 DB        ; EXAM
C12A DD        ; OUTB
C12B 37        ; RTN
; ---- キーを読んでパドルを動かす。2フレームに1段 ----
C12C 02 01     ; LIA 01             KEYS: ↑はIAのビット0で選び、読むとビット4
C12E 12 5C     ; LIP 5C  (KEYPA)
C130 DB        ; EXAM
C131 5D        ; OUTA
C132 4E 0A     ; WAIT 0A
C134 4C        ; INA
C135 64 10     ; ANIA 10
C137 9F        ; LP 1F
C138 DB        ; EXAM
C139 23        ; CLRA
C13A 12 5C     ; LIP 5C  (KEYPA)
C13C DB        ; EXAM
C13D 5D        ; OUTA
C13E 02 01     ; LIA 01             ↓はIBのビット0で選び、読むとビット4
C140 12 5D     ; LIP 5D  (KEYPB)
C142 DB        ; EXAM
C143 DD        ; OUTB
C144 4E 0A     ; WAIT 0A
