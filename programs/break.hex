C147 64 10     ; ANIA 10
C149 AC        ; LP 2C
C14A DB        ; EXAM
C14B 23        ; CLRA
C14C 12 5D     ; LIP 5D  (KEYPB)
C14E DB        ; EXAM
C14F DD        ; OUTB
C150 23        ; CLRA
C151 9D        ; LP 1D
C152 DB        ; EXAM
C153 9F        ; LP 1F
C154 59        ; LDM
C155 67 00     ; CPIA 00
C157 38 14     ; JRZP K_DOWN
C159 02 FF     ; LIA FF
C15B 9D        ; LP 1D
C15C DB        ; EXAM
C15D 9E        ; LP 1E
C15E 59        ; LDM
C15F 64 01     ; ANIA 01
C161 28 2D     ; JRNZP K_END
C163 94        ; LP 14
C164 59        ; LDM
C165 67 00     ; CPIA 00
