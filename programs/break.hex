C18A 3A 04     ; JRCP K_END
C18C 94        ; LP 14
C18D 70 01     ; ADIM 01
C18F 37        ; RTN                K_END:
; ---- SPACEかENTERが押されていればZでない ----
C190 02 30     ; LIA 30             FIRE: SPACEはIAのビット4、ENTERはビット5。読むとビット7
C192 12 5C     ; LIP 5C  (KEYPA)
C194 DB        ; EXAM
C195 5D        ; OUTA
C196 4E 0A     ; WAIT 0A
C198 4C        ; INA
C199 34        ; PUSH
C19A 23        ; CLRA
C19B 12 5C     ; LIP 5C  (KEYPA)
C19D DB        ; EXAM
C19E 5D        ; OUTA
C19F 5B        ; POP
C1A0 64 80     ; ANIA 80
C1A2 37        ; RTN
; ---- 玉をパドルの右に置く ----
C1A3 02 03     ; LIA 03             SETBALL:
C1A5 90        ; LP 10
C1A6 DB        ; EXAM
C1A7 02 01     ; LIA 01
C1A9 92        ; LP 12
C1AA DB        ; EXAM
C1AB 02 06     ; LIA 06
C1AD 93        ; LP 13
C1AE DB        ; EXAM
C1AF 94        ; LP 14              y = PAD*32+48(2段のまんなか)。3段なら+16で真ん中の段
C1B0 59        ; LDM
C1B1 58        ; SWP
C1B2 D1        ; RC
C1B3 5A        ; SL
C1B4 74 30     ; ADIA 30
C1B6 91        ; LP 11
C1B7 DB        ; EXAM
C1B8 95        ; LP 15
C1B9 59        ; LDM
C1BA 67 03     ; CPIA 03
C1BC 28 04     ; JRNZP SB_END
C1BE 91        ; LP 11
C1BF 70 10     ; ADIM 10
C1C1 37        ; RTN                SB_END:
; ---- 壁の先端の列をAに返す ----
C1C2 03 00     ; LIB 00             FRONT: B = 5×本目
C1C4 12 20     ; LIP 20  (BRICK)
C1C6 59        ; LDM                F_LOOP:
C1C7 67 00     ; CPIA 00
C1C9 28 0F     ; JRNZP F_FOUND
C1CB 50        ; INCP
C1CC DA        ; EXAB
C1CD 74 05     ; ADIA 05
C1CF DA        ; EXAB
C1D0 DA        ; EXAB
