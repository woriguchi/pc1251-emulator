# title: 正弦波を流す(マシン語)
# 表(C300から180バイト)の波の形を液晶RAMへ写し、1列ずつずらして流す。
# BRKキー(Esc)で止まってBASICに戻る。「;」から後ろはコメント。

C200 01 01  ; LIJ 01      ROMのMVBが2バイト写すように
C202 02 01  ; LIA 01
C204 FF B1  ; CAL 1FB1    CポートにAを出す(液晶の表示をオン)
C206 02 00  ; LIA 00
C208 88     ; LP 08
C209 DB     ; EXAM        K=0(波をずらす量)
C20A 88     ; LP 08       FRAME:
C20B 59     ; LDM         A=K
C20C 03 C3  ; LIB C3
C20E F1 F1  ; CAL 11F1    X=BA-1(表のK番目の1つ前)
C210 02 00  ; LIA 00
C212 03 F8  ; LIB F8
C214 F1 F5  ; CAL 11F5    Y=F7FF
C216 03 3C  ; LIB 3C      左半分の60列
C218 24     ; IXL         LEFT: A=(+X)
C219 26     ; IYS         (+Y)=A
C21A C3     ; DECB
C21B 29 04  ; JRNZM LEFT
C21D 02 7C  ; LIA 7C
C21F 03 F8  ; LIB F8
C221 F1 EE  ; CAL 11EE    Y=F87C(右半分は番地が逆順)
C223 03 3C  ; LIB 3C
C225 24     ; IXL         RIGHT: A=(+X)
C226 27     ; DYS         (-Y)=A
C227 C3     ; DECB
C228 29 04  ; JRNZM RIGHT
C22A 03 1E  ; LIB 1E      30回待つ(約40ms)
C22C 4E FF  ; WAIT FF     WAIT1:
C22E C3     ; DECB
C22F 29 04  ; JRNZM WAIT1
C231 6B 08  ; TEST 08     BRKキー?
C233 28 0D  ; JRNZP EXIT
C235 88     ; LP 08
C236 59     ; LDM
C237 42     ; INCA        K=K+1
C238 67 3C  ; CPIA 3C     60になったら
C23A 28 03  ; JRNZP +3
C23C 02 00  ; LIA 00      0に戻す
C23E DB     ; EXAM
C23F 2D 36  ; JRM FRAME
C241 37     ; RTN         EXIT:

; 波の形(1列に1バイト、ビット0が上。太さ2ドット)。周期60列を3周ぶん
C300 0C 0C 0C 0C 06 06 06 06 06 03 03 03
C30C 03 03 03 03 03 03 03 03 03 03 06 06
C318 06 06 06 0C 0C 0C 0C 18 18 18 30 30
C324 30 30 30 60 60 60 60 60 60 60 60 60
C330 60 60 60 60 30 30 30 30 30 18 18 18
C33C 18 0C 0C 0C 06 06 06 06 06 03 03 03
C348 03 03 03 03 03 03 03 03 03 03 06 06
C354 06 06 06 0C 0C 0C 0C 18 18 18 30 30
C360 30 30 30 60 60 60 60 60 60 60 60 60
C36C 60 60 60 60 30 30 30 30 30 18 18 18
C378 18 0C 0C 0C 06 06 06 06 06 03 03 03
C384 03 03 03 03 03 03 03 03 03 03 06 06
C390 06 06 06 0C 0C 0C 0C 18 18 18 30 30
C39C 30 30 30 60 60 60 60 60 60 60 60 60
C3A8 60 60 60 60 30 30 30 30 30 18 18 18
